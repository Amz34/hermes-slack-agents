# --- Slack OAuth (required) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- App-level token (xapp-) — generated in Slack dashboard: Basic Information → App-Level Tokens ---
SLACK_APP_TOKEN=

# --- Bot token (xoxb-) — produced by scripts/exchange_code.py after install ---
SLACK_BOT_TOKEN=

# --- Comma-separated Slack user IDs allowed to talk to this bot ---
SLACK_ALLOWED_USERS=
